FROM python:3.12-slim

WORKDIR /app

RUN pip install uv --quiet && DEBIAN_FRONTEND=noninteractive apt-get update -qq && apt-get install -y -qq curl && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --quiet

COPY . .

ENV PYTHONPATH=/app
ENV DJANGO_SETTINGS_MODULE=django_api.config.settings

RUN adduser --disabled-password --gecos "" --no-create-home appuser && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.sh"]
